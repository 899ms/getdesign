# Optional PostHog analytics. Disabled until configuration AND explicit consent.
# Use a different project/token in each environment. Never paste a personal API key.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
POSTHOG_PROJECT_ENV=
POSTHOG_ALLOWED_ORIGINS=
# Only needed for non-Vercel builds; VERCEL_ENV overrides this value.
POSTHOG_DEPLOYMENT_ENV=
# Setup, event schema, consent policy, and live verification: ../../docs/analytics.md
# WorkOS AuthKit. Register this callback in the application's Redirects settings.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Convex deployment. Configure the same WORKOS_CLIENT_ID in Convex.
NEXT_PUBLIC_CONVEX_URL=

# Server-only encryption key for saved provider credentials (32 bytes, hex/base64).
# Generate once: openssl rand -hex 32
# Keep the same key when connecting to existing saved provider credentials.
GETDESIGN_CREDENTIALS_KEY=

# Vercel Production only: production deploy key used by the deployment + seed build hook.
# For isolated Vercel previews, configure a Preview Deploy Key in Preview instead.
CONVEX_DEPLOY_KEY=
